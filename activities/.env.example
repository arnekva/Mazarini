# Copy to .env.local (git-ignored) and fill in real values.

# Discord application the daily-hub Activity is registered under (same app the bot's
# DISCORD_ACTIVITY_APP_ID points at). Exposed to the browser - not a secret.
NEXT_PUBLIC_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot token, used server-side only to post completion announcements to Discord.
DISCORD_BOT_TOKEN=

# Same Firebase project the bot uses (client-env.ts in the repo root).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# 'dev' or 'prod' - which top-level node in the Firebase RTDB to read/write, same as the bot's DATABASE var.
DATABASE=dev
