# Copy to .env.local (git-ignored) and fill in real values.

# Discord application the daily-hub Activity is registered under (same app the bot's
# DISCORD_ACTIVITY_APP_ID points at). Exposed to the browser - not a secret.
NEXT_PUBLIC_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot token, used server-side only to post completion announcements to Discord.
DISCORD_BOT_TOKEN=

# Same Firebase project the bot uses (client-env.ts in the repo root).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# 'dev' or 'prod' - which top-level node in the Firebase RTDB to read/write, same as the bot's DATABASE var.
DATABASE=dev

# Same Spotify app the bot uses (client-env.ts in the repo root). Used both for the app-only
# client-credentials grant (reading public playlist data) and the user login flow below.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must be added as an exact Redirect URI on this app in the Spotify Developer Dashboard
# (Settings > Redirect URIs). Spotify requires the literal IP for loopback, not "localhost".
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# Local testing without Discord: run `npm run dev` and open http://localhost:3000/?devUser=<discordId>[:<name>].
# Use a different devUser per browser tab to test multiplayer alone. Ignored in production builds; Discord posts are
# skipped while on. Point DATABASE at 'dev' - it reads/writes real Firebase data for whatever user id you use.
NEXT_PUBLIC_DEV_AUTH=1
